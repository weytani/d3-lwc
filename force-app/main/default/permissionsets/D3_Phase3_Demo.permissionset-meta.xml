<?xml version="1.0" encoding="UTF-8" ?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <description
  >Grants read access to the three Opportunity custom fields used by the Phase 3 D3 chart showcase (Gantt and Bubble charts). Required so stripInaccessible(READABLE) in D3ChartController returns these fields even for a System Administrator.</description>
    <hasActivationRequired>false</hasActivationRequired>
    <label>D3 Phase 3 Demo</label>
    <fieldPermissions>
        <field>Opportunity.Project_Start__c</field>
        <editable>false</editable>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Opportunity.Project_End__c</field>
        <editable>false</editable>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Opportunity.Forecast_Units__c</field>
        <editable>false</editable>
        <readable>true</readable>
    </fieldPermissions>
    <tabSettings>
        <tab>d3_lwc_phase3</tab>
        <visibility>Visible</visibility>
    </tabSettings>
</PermissionSet>
